terraform {
  # Pinned to a minor-version floor with an upper bound, so a future major
  # release cannot silently change plan behaviour in CI.
  required_version = ">= 1.6.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
  }
}
